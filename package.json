{
  "name": "caldera",
  "version": "1.7.8",
  "description": "A proprietary freeware visual event calendar with local-first event import functionality",
  "main": "dist/main.js",
  "scripts": {
    "start": "node scripts/start-electron.js",
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json && vite build",
    "build:react": "vite build",
    "watch:react": "vite build --watch",
    "typecheck:react": "tsc -p tsconfig.react.json",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win"
  },
  "keywords": [],
  "author": "ZenFrog",
  "license": "SEE LICENSE IN LICENSE",
  "build": {
    "appId": "com.caldera.app",
    "productName": "Caldera",
    "files": [
      "dist/main.js",
      "dist/preload.js",
      "dist/renderer-ui.js",
      "dist/renderer-data.js",
      "dist/clock.js",
      "dist/renderer.js",
      "dist/ai-import.js",
      "dist/ai/**/*.js",
      "dist/react/**",
      "index.html",
      "styles.css",
      "fonts/**",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "dir"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^40.6.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.0.0",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  }
}
