{
  "name": "caldera",
  "version": "1.1.0",
  "description": "A simple visual event calendar with drag and drop support",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "keywords": [],
  "author": "Lucidian Creative",
  "license": "SEE LICENSE IN LICENSE",
  "build": {
    "appId": "com.caldera.app",
    "productName": "Caldera",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "build/icon.png"
    ],
    "win": {
      "target": ["nsis", "dir"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^40.6.1",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.1"
  }
}
